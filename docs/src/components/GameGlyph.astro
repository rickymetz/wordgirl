---
// The games' actual title icons, ported from each GameScreen.tsx
// (Polygram's live clip-path polygon becomes a static hexagon).
// All draw in currentColor so they inherit the in-scope accent.
interface Props {
  game: "polygram" | "crosshatch" | "pierglass" | "doublet" | "serpentine";
  size?: number;
}
const { game, size = 20 } = Astro.props;
---

{game === "polygram" && (
  <svg role="img" aria-hidden="true" width={size} height={size} viewBox="0 0 20 20">
    <polygon
      points="10,1.5 17.36,5.75 17.36,14.25 10,18.5 2.64,14.25 2.64,5.75"
      fill="currentColor"
    />
  </svg>
)}
{game === "crosshatch" && (
  <svg role="img" aria-hidden="true" width={size} height={size} viewBox="0 0 20 20">
    <g stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
      <line x1="7" y1="2.5" x2="7" y2="17.5" />
      <line x1="13" y1="2.5" x2="13" y2="17.5" />
      <line x1="2.5" y1="7" x2="17.5" y2="7" />
      <line x1="2.5" y1="13" x2="17.5" y2="13" />
    </g>
  </svg>
)}
{game === "pierglass" && (
  <svg role="img" aria-hidden="true" width={size} height={size} viewBox="0 0 20 20">
    <g fill="currentColor">
      <rect x="9.25" y="2.5" width="1.5" height="15" rx="0.75" />
      <path d="M6.5 5.5v9L2 10z" />
      <path d="M13.5 5.5v9L18 10z" />
    </g>
  </svg>
)}
{game === "doublet" && (
  <svg role="img" aria-hidden="true" width={size} height={size} viewBox="0 0 20 20">
    <rect x="1" y="5" width="8" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="2" />
    <rect x="11" y="5" width="8" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="2" />
  </svg>
)}
{game === "serpentine" && (
  <svg role="img" aria-hidden="true" width={size} height={size} viewBox="0 0 20 20">
    <path
      d="M5 3c0 2 5 3 5 5s-5 3-5 5 5 3 5 5"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
    />
  </svg>
)}
